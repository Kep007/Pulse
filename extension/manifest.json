{
  "manifest_version": 3,
  "name": "Pulse Companion",
  "version": "1.1.0",
  "description": "Segnala a Pulse (in locale) la scheda attiva del browser, per riconoscere il progetto anche da WhatsApp Web, PDF e file locali (e ignorare Pinterest).",
  "key": "",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:47771/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["whatsapp-content.js"],
      "run_at": "document_idle"
    }
  ]
}
