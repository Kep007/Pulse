{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "2.0.2",
  "identifier": "app.pulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 220,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "home",
        "title": "Pulse",
        "width": 820,
        "height": 636,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "toast",
        "title": "Pulse",
        "width": 320,
        "height": 40,
        "x": 16,
        "y": 16,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQ0E3OTRGQjlGMjUxMTkKUldRWlVmSzVUM25LdnYvR0taRWJVWDQ4M3BqcjNoeTdXTFAvUHJEWU5TUjMyL1FUN0h2d3dEaFoK",
      "endpoints": [
        "https://github.com/Kep007/Pulse/releases/latest/download/latest.json"
      ]
    }
  }
}
